# ---- Server-side (Vercel serverless functions in /api). NEVER prefix these with VITE_ ----
GOOGLE_SHEET_ID=1BrzzzTtCp1gsiEUitn5K0XevzqQa0vvPpXSq_y55loo
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
