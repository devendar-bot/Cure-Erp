GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Frontend (optional) ----
# Set to "true" to run `npm run dev` against the localStorage mock instead of the Sheet
VITE_USE_MOCK=false
